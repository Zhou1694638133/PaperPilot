# Copy to .env beside this file. Never commit .env or backend model-config.json.
# Research preferences can securely submit model settings to the local backend.
# Saved backend settings override the three LLM fields below without a restart.
APP_MODE=live
# Optional absolute SQLite path; omit to use PaperPilot/data/paperpilot.db.
# DATABASE_PATH=C:/path/to/PaperPilot/data/paperpilot.db

# OpenAI-compatible Chat Completions endpoint. A model name AND key are required.
# Only chat-completions JSON/text responses are supported; no tools are invoked.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=90
# true: inherit HTTP(S)_PROXY/ALL_PROXY/NO_PROXY and certificate environment settings.
# false: direct connection; only set after verifying your provider supports direct access.
LLM_TRUST_ENV=true
LLM_MAX_TOKENS=4096

ARXIV_TIMEOUT=30
FULLTEXT_TIMEOUT=120
# Optional embedded Chinese TrueType/TTC font for PDF reports (default: Windows SimSun).
# PDF_FONT_PATH=C:/Windows/Fonts/simsun.ttc
ARXIV_CACHE_TTL=3600
# Enforced minimum 3 seconds across workers using the same database.
ARXIV_MIN_INTERVAL=3

# Phase 1 is a single worker. These two reserved options are not enabled yet.
# WORKER_CONCURRENCY=1
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Provider capability switches (opt in only when the chosen provider supports them).
LLM_JSON_MODE=false
LLM_TOKEN_PARAMETER=max_tokens
LLM_SEND_TEMPERATURE=false
# Official DeepSeek Flash/V4: prevent reasoning from exhausting extraction/translation output budget.
# Only sent to api.deepseek.com; set enabled explicitly if reasoning is wanted.
LLM_DEEPSEEK_THINKING=disabled
